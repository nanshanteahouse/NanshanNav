# OPTIONAL authenticated reverse proxy; use docker-compose.authelia.yml alone.
NAV_DOMAIN=nav.example.com
NAV_PUBLIC_URL=https://nav.example.com
# An external TLS proxy forwards this exact origin to the loopback HTTP upstream.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8080
NAV_READ_ONLY=false
NAV_PVE_HOSTS_JSON=[]
NAV_HEALTH_TARGETS_JSON=[]
NAV_EMBED_ORIGINS=
PVE_ENCRYPTION_KEY=
# Generate each secret separately: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=
STORAGE_ENCRYPTION_KEY=
AUTHELIA_USER=admin
AUTHELIA_EMAIL=admin@example.com
# Authelia 4.38.18: crypto hash generate argon2. Preserve $ with single quotes.
AUTHELIA_PASSWORD=''
