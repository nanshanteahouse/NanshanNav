# NanshanNav — Docker Deployment Environment Variables
# Copy this file to .env and fill in your values:
#   cp docker/.env.example .env

# Backend port (internal, used within Docker network)
PORT=3001

# Upload directory path (inside container)
UPLOAD_DIR=/app/uploads

# PVE API token for Proxmox monitoring (optional)
# Generate: pveum user token add monitor@pve dashboard --privsep 0
PVE_API_TOKEN=monitor@pve!dashboard=YOUR_TOKEN_HERE

# Encryption key for PVE tokens (32 bytes hex, REQUIRED for token persistence)
# Generate: openssl rand -hex 32
# WARNING: Losing this key means all encrypted PVE tokens become unrecoverable!
PVE_ENCRYPTION_KEY=

# Authelia authentication
AUTHELIA_USER=admin
# Generate bcrypt hash: docker run --rm authelia/authelia:latest authelia hash-password 'your-password'
AUTHELIA_PASSWORD=

# Authelia secrets (generate: openssl rand -hex 32)
JWT_SECRET=
SESSION_SECRET=

# Nginx port mappings (host machine)
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
