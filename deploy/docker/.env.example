# Repository root: cp deploy/docker/.env.example .env
# docker compose --env-file .env -f deploy/docker/docker-compose.yml up -d --build
# Open http://SERVER_IP:3001/ and http://SERVER_IP:3001/admin (no login).
NAV_BIND_ADDRESS=0.0.0.0
NAV_HTTP_PORT=3001
# true disables /admin and /api/admin, including descendants.
NAV_READ_ONLY=false
NAV_PVE_HOSTS_JSON=[]
NAV_HEALTH_TARGETS_JSON=[]
NAV_EMBED_ORIGINS=
# Blank: create a persistent key in server/config/.pve-key; back it up.
PVE_ENCRYPTION_KEY=
