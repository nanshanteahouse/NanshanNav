# OPTIONAL Authelia proxy, behind an external TLS terminator preserving Host.
# All SPA/static/upload requests go through the backend for CSP and validation.
upstream backend { server 127.0.0.1:3001; }
upstream authelia { server 127.0.0.1:9091; }
server {
    listen 127.0.0.1:8080;
    server_name nav.example.com;
    client_max_body_size 21m;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;

    location = /authelia {
        internal;
        # Authelia 4.38.18 exposes authz at this root even with server base path /auth.
        proxy_pass http://authelia/api/authz/auth-request;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URL https://nav.example.com$request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Connection "";
    }
    location = /auth { return 301 https://nav.example.com/auth/; }
    location ^~ /auth/ {
        proxy_pass http://authelia;
    }
    location = /admin {
        auth_request /authelia;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        auth_request_set $redirection_url $upstream_http_location;
        error_page 401 =302 $redirection_url;
        proxy_pass http://backend;
    }
    location ^~ /admin/ {
        auth_request /authelia;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        auth_request_set $redirection_url $upstream_http_location;
        error_page 401 =302 $redirection_url;
        proxy_pass http://backend;
    }
    location = /api/admin {
        auth_request /authelia;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        proxy_pass http://backend;
    }
    location ^~ /api/admin/ {
        auth_request /authelia;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;
        proxy_pass http://backend;
    }
    # Public display and public read APIs. API authentication failures stay 401/403.
    location / {
        proxy_pass http://backend;
    }
}
