# 开发/宿主机：Node 22+；tsx --env-file=.env server/index.ts 加载本文件
FRONTEND_PORT=5173
BACKEND_PORT=3001
PORT=3001
HOST=127.0.0.1
UPLOAD_DIR=./uploads
# 无内置登录；管理入口 /admin、管理API /api/admin/* 对可访问实例的设备开放。
# 仅展示部署设置true，关闭管理页面和管理API。
NAV_READ_ONLY=false
# 已登记PVE主机，固定HTTPS origin；默认/全局令牌不再使用。
NAV_PVE_HOSTS_JSON='[{"id":"home","url":"https://pve.lan:8006","addresses":["192.168.1.10"]}]'
# 健康检查仅允许这些精确URL；允许管理员明确登记家庭内网服务。
NAV_HEALTH_TARGETS_JSON='[{"id":"nas","url":"http://192.168.1.20/"}]'
# iframe精确origin，逗号分隔，空值只允许本站。
NAV_EMBED_ORIGINS=
# 内部CA：填写PEM证书绝对路径，替代NODE_TLS_REJECT_UNAUTHORIZED=0。
# NODE_EXTRA_CA_CERTS=/etc/nanshan/internal-ca.pem
# 令牌加密密钥，空值在server/config/.pve-key自动创建；务必备份。
PVE_ENCRYPTION_KEY=
