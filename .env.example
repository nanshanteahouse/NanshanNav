# NanshanNav — 开发环境变量
# 复制此文件为 .env 后按需修改：
#   cp .env.example .env

# 前端开发服务器端口（Vite 默认 :5173）
FRONTEND_PORT=5173

# 后端 API 服务器端口（Hono 默认 :3001）
BACKEND_PORT=3001

# 后端服务监听端口（同 BACKEND_PORT，Hono 运行时使用）
PORT=3001

# 文件上传目录（开发模式）
UPLOAD_DIR=./uploads

# PVE API 令牌（环境变量回退，会加密存储）
# 格式: <user>@<realm>!<tokenid>=<secret>
PVE_API_TOKEN=monitor@pve!dashboard=YOUR_TOKEN_HERE

# PVE 令牌加密密钥（32 字节 hex，自动生成时无需设置）
# 生成: openssl rand -hex 32
# PVE_ENCRYPTION_KEY=
