# =============================================================================
# NanshanNav — Nginx configuration example (upload server + Authelia auth)
# =============================================================================
# This snippet supplements an existing Nginx + Authelia setup with the
# upload API, static file serving, and admin-protected location for the
# dashboard edit mode.
#
# Place relevant blocks inside the appropriate server { } context.
#
# REQUIREMENTS:
#   - The main SPA (index.html) must be served at both / and /admin.
#     Add the following to your existing SPA location blocks:
#       location / { try_files $uri $uri/ /index.html; }
#       location /admin { try_files $uri $uri/ /index.html; }   # see below
# =============================================================================

# ---------------------------------------------------------------------------
# Authelia auth_request — internal endpoint used by auth_request directives
# ---------------------------------------------------------------------------
location /authelia {
    internal;
    proxy_pass http://127.0.0.1:9091/api/verify;  # default Authelia port
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";

    # Pass the original request info so Authelia can evaluate access rules
    proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Forwarded-For $remote_addr;
}

# ---------------------------------------------------------------------------
# Upload API — proxied to the Hono upload server (port 3001)
# ---------------------------------------------------------------------------
location /api/upload {
    auth_request /authelia;

    # Propagate the Authelia session cookie back to the client
    auth_request_set $auth_cookie $upstream_http_set_cookie;
    add_header Set-Cookie $auth_cookie;

    client_max_body_size 20m;

    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# ---------------------------------------------------------------------------
# Uploaded files — serve static files from the uploads directory
#
# NOTE: If you want the uploaded images to be publicly accessible (no login
# required), remove or comment out the auth_request /authelia and the two
# auth_request_set / add_header lines below.
# ---------------------------------------------------------------------------
location /uploads/ {
    auth_request /authelia;
    auth_request_set $auth_cookie $upstream_http_set_cookie;
    add_header Set-Cookie $auth_cookie;

    alias /var/www/nanshan-nav/uploads/;

    expires 30d;
    add_header Cache-Control "public, immutable";
}

# ---------------------------------------------------------------------------
# PVE API — proxied to the Hono server (port 3001) which handles token auth
# ---------------------------------------------------------------------------
location /api/pve/ {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
}

# ---------------------------------------------------------------------------
# Admin SPA — same dashboard app but auto-activates edit mode
#
# The frontend useAutoEditMode hook checks window.location.pathname and
# automatically enables edit mode when the path starts with /admin.
#
# Add auth_request here to restrict edit access. Remove or comment out
# the auth lines if you want the edit UI publicly accessible.
#
# IMPORTANT: This location MUST serve the same index.html as the root
# location / to ensure the SPA handles the /admin route correctly.
# ---------------------------------------------------------------------------
location /admin {
    auth_request /authelia;
    auth_request_set $auth_cookie $upstream_http_set_cookie;
    add_header Set-Cookie $auth_cookie;

    # Point this to the same root as your main SPA location
    root /var/www/nanshan-nav/dist;
    try_files $uri $uri/ /index.html;
}
